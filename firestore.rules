rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath())
        && get(userPath()).data.get('role', 'user') == 'admin';
    }

    function validRole() {
      return !('role' in request.resource.data)
        || request.resource.data.role in ['user', 'admin'];
    }

    function roleUnchanged() {
      return request.resource.data.get('role', null) == resource.data.get('role', null)
        || (!('role' in resource.data) && validRole());
    }

    function validFavorites() {
      return !('favorites' in request.resource.data)
        || request.resource.data.favorites is list;
    }

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validBook(book) {
      return book.keys().hasOnly([
          'creatorId', 'name', 'coverUrl', 'author',
          'description', 'year', 'category', 'createdAt'
        ])
        && book.keys().hasAll(['creatorId', 'name', 'author', 'year', 'category', 'createdAt'])
        && isString(book.name, 1, 200)
        && isString(book.author, 0, 200)
        && (!('description' in book) || isString(book.description, 0, 5000))
        && (!('coverUrl' in book) || book.coverUrl == null || isString(book.coverUrl, 0, 2000))
        && book.year is int && book.year >= 0 && book.year <= 3000
        && book.category is list && book.category.size() >= 1 && book.category.size() <= 10
        && book.createdAt is timestamp;
    }

    match /books/{bookId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && validBook(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && (resource.data.creatorId == request.auth.uid || isAdmin())
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.createdAt == resource.data.createdAt
        && validBook(request.resource.data);
      allow delete: if signedIn()
        && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validRole() && validFavorites();
      allow update: if isOwner(uid) && roleUnchanged() && validFavorites();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
